{
  "name": "frontend-interview-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "前端面试研习社 - Vue 3 + TypeScript 全栈学习项目（对标阿里 P9）",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter web --filter server run dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "server": "pnpm --filter server dev",
    "build": "pnpm --filter web build",
    "preview": "pnpm --filter web preview",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "format": "prettier --write \"**/*.{ts,tsx,vue,js,json,md,css,scss,html}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,js,json,md,css,scss,html}\"",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r --parallel run test",
    "e2e": "pnpm -C playwright e2e",
    "clean": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "stylelint": "^16.11.0",
    "stylelint-config-recess-order": "^5.0.0",
    "stylelint-config-standard": "^36.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vue-eslint-parser": "^9.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "prettier --write",
      "stylelint --fix"
    ],
    "*.{json,md,html}": [
      "prettier --write"
    ]
  }
}
